{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "memory": 3000,
      "includeFiles": "node_modules/{ffmpeg-static,@sparticuz/chromium}/**"
    },
    "api/docs.ts": { "maxDuration": 10, "memory": 256 }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/index" },
    { "source": "/", "destination": "/api/docs" },
    { "source": "/docs", "destination": "/api/docs" }
  ]
}
